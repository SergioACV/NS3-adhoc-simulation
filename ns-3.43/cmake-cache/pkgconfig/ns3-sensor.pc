exec_prefix="/usr/local/bin"
libdir="/usr/local/lib"
includedir="/usr/local/include"

Name: ns3-sensor
Description: 
URL: 
Version: 3.43
Requires:  ns3-core ns3-netanim ns3-network ns3-mobility ns3-spectrum ns3-propagation
Requires.private: 
Cflags: -I"${includedir}"  -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr -I/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/libxml2
Libs: -L"${libdir}" -lns3.43-sensor-default  -lns3.43-core-default -lns3.43-netanim-default -lns3.43-network-default -lns3.43-mobility-default -lns3.43-spectrum-default -lns3.43-propagation-default
Libs.private: -L"${libdir}" 
